{
  "name": "@im/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate": "prisma validate --schema prisma/schema.prisma",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "doctor": "node --import tsx prisma/doctor.ts",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "node --import tsx prisma/seed.ts",
    "studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@im/logger": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0"
  }
}
