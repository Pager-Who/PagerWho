# Required: PostgreSQL reachable from the containers, not container loopback.
DATABASE_URL=postgresql://pagerwho:REPLACE_WITH_DB_PASSWORD@host.docker.internal:5432/pagerwho
WEB_APP_URL=https://pagerwho.example.com
WEBHOOK_SECRET_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

# Host entry point; use different ports if running dev and prod together.
PAGERWHO_HTTP_PORT=8080
# PAGERWHO_HTTP_BIND=127.0.0.1

# Use live for real delivery; missing providers must fail visibly.
NOTIFICATION_DELIVERY_MODE=live

# Authentication SMTP is required to verify new email/password accounts.
# Omit only with OIDC or already-verified users. Separate from project notification SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional OIDC; configure all four provider fields and the state secret.
# AUTH_STATE_SECRET=
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://pagerwho.example.com/api/v1/auth/oidc/callback
# OIDC_PROVIDER_ID=google
# OIDC_PROVIDER_LABEL=Google

# Optional phone verification for SMS/phone alerts.
# PHONE_VERIFICATION_SECRET=

# Advanced defaults and installation limits are documented in README.md.
