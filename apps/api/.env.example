# Core API settings. Development secrets below must be replaced before deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_management
WEB_APP_URL=http://localhost:5173
WEBHOOK_SECRET_PEPPER=dev-pepper
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=dev-provider-credential-key-change-me

# Authentication SMTP: needed to verify new email/password accounts.
# Optional only with OIDC or already-verified users; also delivers password resets.
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional: external login (OIDC). Configure all required fields together.
# AUTH_STATE_SECRET=
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
# OIDC_PROVIDER_ID=google
# OIDC_PROVIDER_LABEL=Google

# Optional: required when enabling phone verification for SMS or phone alerts.
# PHONE_VERIFICATION_SECRET=

# Default ports, session settings, and installation limits need no overrides.
# See README.md for API configuration and optional tuning.
