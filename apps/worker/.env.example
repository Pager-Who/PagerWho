DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_management
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=dev-provider-credential-key-change-me
WORKER_POLL_INTERVAL_MS=5000
WORKER_NOTIFICATION_BATCH_SIZE=25
WORKER_NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_HTTP_TIMEOUT_MS=10000

# auto: send through registered provider URLs, otherwise log locally.
# live: require provider configuration and fail notifications when missing.
# log: never send externally.
NOTIFICATION_DELIVERY_MODE=log
WEB_APP_BASE_URL=http://localhost:5173

# Slack targets are registered per user or escalation step as Slack Incoming Webhook URLs.
# Email targets are registered per user as delivery webhook URLs backed by SES, SMTP relay, or another mail service.
# SMS and phone call delivery use Twilio. Phone numbers must be verified before notifications are routed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=

# Installation resource limits: 0 means unlimited. Keep API and worker values aligned.
PAGERWHO_LIMIT_WORKSPACES=0
PAGERWHO_LIMIT_MEMBERS=0
PAGERWHO_LIMIT_SERVICES=0
PAGERWHO_LIMIT_ON_CALL_SCHEDULES=0
PAGERWHO_LIMIT_ESCALATION_POLICIES=0
# Positive number of days, from 1 to 36500. Cleanup is performed by the worker.
PAGERWHO_RETENTION_DAYS=365
